# ProcureWatch — przykładowa konfiguracja środowiska
# Skopiuj ten plik jako .env i uzupełnij wartości lokalne.
# Plik .env jest ignorowany przez git — nigdy nie commituj sekretów.

# Baza danych (opcjonalna — na przyszłe rozszerzenia pipeline'u)
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Streamlit (opcjonalna konfiguracja serwera)
STREAMLIT_SERVER_PORT=
STREAMLIT_SERVER_ADDRESS=
